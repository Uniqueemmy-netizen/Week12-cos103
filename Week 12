import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

# load the data
df = pd.read_csv("Iris.csv")
df = df.drop(columns=["Id"])

X = df.drop(columns=["Species"]).values
y = df["Species"].values
cols = list(df.drop(columns=["Species"]).columns)
classes = np.unique(y)

# shuffle and split 70/30
np.random.seed(42)
idx = np.random.permutation(len(X))
cut = int(0.7 * len(X))
X_train, y_train = X[idx[:cut]], y[idx[:cut]]
X_test, y_test = X[idx[cut:]], y[idx[cut:]]


# gini impurity, 0 means the group is all one species
def gini(labels):
    _, counts = np.unique(labels, return_counts=True)
    p = counts / len(labels)
    return 1 - np.sum(p ** 2)


# loop through every feature and every value to find the best split
def best_split(X, y):
    best_f = None
    best_t = None
    best_score = 1
    for f in range(X.shape[1]):
        for t in np.unique(X[:, f]):
            left = y[X[:, f] <= t]
            right = y[X[:, f] > t]
            if len(left) == 0 or len(right) == 0:
                continue
            score = (len(left) * gini(left) + len(right) * gini(right)) / len(y)
            if score < best_score:
                best_score = score
                best_f = f
                best_t = t
    return best_f, best_t


def build_tree(X, y, depth=0, max_depth=4):
    vals, counts = np.unique(y, return_counts=True)
    common = vals[np.argmax(counts)]

    # stop if all same species or tree is deep enough
    if len(vals) == 1 or depth == max_depth:
        return {"leaf": True, "label": common}

    f, t = best_split(X, y)
    if f is None:
        return {"leaf": True, "label": common}

    mask = X[:, f] <= t
    return {"leaf": False, "f": f, "t": t,
            "left": build_tree(X[mask], y[mask], depth + 1, max_depth),
            "right": build_tree(X[~mask], y[~mask], depth + 1, max_depth)}


def predict(node, row):
    while not node["leaf"]:
        if row[node["f"]] <= node["t"]:
            node = node["left"]
        else:
            node = node["right"]
    return node["label"]


def show_tree(node, depth=0):
    space = "    " * depth
    if node["leaf"]:
        print(space + "->", node["label"])
    else:
        print(space + "if", cols[node["f"]], "<=", node["t"])
        show_tree(node["left"], depth + 1)
        print(space + "else")
        show_tree(node["right"], depth + 1)


tree = build_tree(X_train, y_train)
show_tree(tree)

# predictions on test data
y_pred = np.array([predict(tree, row) for row in X_test])

# accuracy
acc = np.mean(y_pred == y_test)

# precision and recall for each species
prec_list = []
rec_list = []
print()
for c in classes:
    tp = np.sum((y_pred == c) & (y_test == c))
    fp = np.sum((y_pred == c) & (y_test != c))
    fn = np.sum((y_pred != c) & (y_test == c))
    p = tp / (tp + fp)
    r = tp / (tp + fn)
    prec_list.append(p)
    rec_list.append(r)
    print(c, "precision:", round(p, 3), "recall:", round(r, 3))

print()
print("Accuracy:", round(acc, 3))
print("Precision:", round(np.mean(prec_list), 3))
print("Recall:", round(np.mean(rec_list), 3))

# confusion matrix
cm = np.zeros((3, 3), dtype=int)
for a, p in zip(y_test, y_pred):
    cm[list(classes).index(a), list(classes).index(p)] += 1

plt.imshow(cm, cmap="Blues")
plt.colorbar()
plt.xticks(range(3), classes, rotation=20)
plt.yticks(range(3), classes)
for i in range(3):
    for j in range(3):
        plt.text(j, i, cm[i, j], ha="center", va="center")
plt.xlabel("Predicted")
plt.ylabel("Actual")
plt.title("Confusion Matrix")
plt.tight_layout()
plt.savefig("confusion_matrix.png")
plt.show()
